# Production Environment Configuration
# Use these settings for live deployment

# Database Configuration (Use managed database service)
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_HOST=${DB_HOST}
DB_PORT=5432
DB_NAME=raw_systematiek

# Server Configuration
PORT=10000
NODE_ENV=production

# Client Configuration
NEXT_PUBLIC_API_URL=https://raw-platform-api.onrender.com/api

# Security
JWT_SECRET=${JWT_SECRET}

# CORS Configuration
CORS_ORIGIN=https://raw-platform.vercel.app

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}

# Monitoring
LOG_LEVEL=info
