{
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "outputDirectory": "client/.next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": {
      "description": "Backend API URL",
      "required": true,
      "default": "http://localhost:5000/api"
    }
  }
}
